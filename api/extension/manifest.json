{
  "manifest_version": 3,
  "name": "Habari: I need a friend",
  "short_name": "Habari",
  "version": "0.4.0",
  "description": "Report something that happened online, in two clicks. You are not in trouble.",
  "action": { "default_popup": "popup.html", "default_title": "I need a friend" },
  "background": { "service_worker": "background.js" },
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "https://*.ngrok-free.app/*"]
}
